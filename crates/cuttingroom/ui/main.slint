import { AboutPopup } from "about.slint";
import { ProgressIndicator } from "std-widgets.slint";
import { BottomBar } from "bottom-bar.slint";
import { Message, MessageDialog, MessageSeverity } from "message-dialog.slint";
import { FullPreview } from "photo-canvas.slint";
import { ActiveSummary, FileDetails, GridPhoto, MetadataEntry, MetadataFile, PhotoMetadata, PreviewState } from "photo-grid.slint";
import { Palette } from "theme.slint";
import { WorkspaceHeader, WorkspaceView } from "workspace-header.slint";
import { PhotoWorkspace } from "workspace.slint";

export { ActiveSummary, FileDetails, FullPreview, GridPhoto, MetadataEntry, MetadataFile, PhotoMetadata, PreviewState, Message, MessageSeverity }

export struct ThumbnailProgress {
    total: int,
    generated: int,
    finished: int,
    cached: int,
    incomplete: bool,
}

import "assets/fonts/NotoSans-Regular.ttf";
import "assets/fonts/NotoSans-SemiBold.ttf";

export component MainWindow inherits Window {
    title: "CuttingRoom";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 850px;
    min-height: 580px;
    background: Palette.canvas;
    default-font-family: "Noto Sans";
    default-font-size: 14px;

    in property <string> app-version;
    in property <string> project-title: "No project open";
    in property <[StandardListViewItem]> photo-files;
    in property <[GridPhoto]> grid-photos;
    in property <FullPreview> full-preview: { index: -1, requested-file: -1 };
    in property <ActiveSummary> active-summary: { index: -1 };
    in property <FileDetails> file-details: { index: -1, file-index: -1 };
    out property <bool> metadata-summary-visible: workspace.metadata-summary-visible;
    out property <bool> metadata-details-visible: workspace.metadata-details-visible;
    out property <int> metadata-file-index: workspace.metadata-file-index;
    in-out property <int> active-index: -1;
    out property <bool> photo-view-active: root.view == WorkspaceView.photo;
    in property <string> status-text;
    in property <bool> project-open;
    in property <bool> scan-active;
    in property <bool> thumbnail-reset-active;
    in property <ThumbnailProgress> thumbnail-progress;
    callback rescan-folder();
    callback rebuild-thumbnail-cache();
    callback message-dismissed(accepted: bool);
    callback thumbnail-viewport-changed(int, int);
    callback active-photo-changed();
    callback preview-file-selected(int, int);
    private property <WorkspaceView> view: WorkspaceView.grid;
    private property <bool> show-project-info: true;
    private property <bool> show-filmstrip: true;
    private property <bool> show-inspector: true;
    private property <Message> current-message;
    private property <bool> popup-open: message-dialog.is-open || about.is-open;
    private property <bool> generating-thumbnails: !root.scan-active && !root.thumbnail-reset-active
        && root.thumbnail-progress.generated < root.thumbnail-progress.total;
    private property <bool> saving-thumbnails: !root.scan-active && !root.thumbnail-reset-active
        && !root.generating-thumbnails && root.thumbnail-progress.finished < root.thumbnail-progress.total;

    forward-focus: navigation;
    init => { navigation.focus(); }

    changed active-index => {
        if !root.popup-open { navigation.focus(); }
        root.active-photo-changed();
    }
    changed view => {
        navigation.focus();
        root.active-photo-changed();
    }
    changed show-project-info => {
        if !root.show-project-info { navigation.focus(); }
    }
    changed show-filmstrip => {
        if !root.show-filmstrip { navigation.focus(); }
    }
    changed show-inspector => {
        if !root.show-inspector { navigation.focus(); }
    }
    changed metadata-summary-visible => { root.active-photo-changed(); }
    changed metadata-details-visible => { root.active-photo-changed(); }
    changed metadata-file-index => { root.active-photo-changed(); }

    public function show-message(message: Message) {
        root.current-message = message;
        if !message-dialog.is-open {
            message-dialog.show();
        }
    }

    MenuBar {
        Menu {
            title: "CuttingRoom";
            MenuItem {
                title: "About CuttingRoom";
                role: MenuItemRole.about;
                enabled: !root.popup-open;
                activated => { about.show(); }
            }
            MenuSeparator {}
            MenuItem {
                title: "Preferences";
                role: MenuItemRole.preferences;
                enabled: false;
            }
        }
        Menu {
            title: "File";
            MenuItem {
                title: "Rescan Folder";
                shortcut: @keys(Control + R);
                enabled: root.project-open && !root.scan-active && !root.thumbnail-reset-active && !root.popup-open;
                activated => { root.rescan-folder(); }
            }
            MenuItem {
                title: "Rebuild Thumbnail Cache";
                enabled: root.project-open && !root.scan-active && !root.thumbnail-reset-active && !root.popup-open;
                activated => { root.rebuild-thumbnail-cache(); }
            }
            MenuItem { title: "Export Metadata"; enabled: false; }
            MenuSeparator {}
            MenuItem {
                title: "Close Window";
                shortcut: @keys(Control + W);
                enabled: !root.popup-open;
                activated => { root.close(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; enabled: false; }
            MenuItem { title: "Redo"; enabled: false; }
        }
        Menu {
            title: "View";
            for option in [
                { title: "Grid", shortcut: header.grid-shortcut, view: WorkspaceView.grid },
                { title: "List", shortcut: header.list-shortcut, view: WorkspaceView.list },
                { title: "Photo", shortcut: header.photo-shortcut, view: WorkspaceView.photo },
            ]: MenuItem {
                title: option.title;
                shortcut: option.shortcut;
                enabled: !root.popup-open;
                activated => { root.view = option.view; }
            }
            MenuSeparator {}
            MenuItem {
                title: "Photo Information";
                shortcut: @keys(I);
                enabled: !root.popup-open;
                checkable: true;
                checked <=> root.show-inspector;
            }
            MenuItem {
                title: "Project Information";
                shortcut: @keys(P);
                enabled: !root.popup-open;
                checkable: true;
                checked <=> root.show-project-info;
            }
            MenuItem {
                title: "Filmstrip";
                shortcut: @keys(F);
                enabled: !root.popup-open;
                checkable: true;
                checked <=> root.show-filmstrip;
            }
        }
    }

    navigation := FocusScope {
        focus-on-tab-navigation: false;

        capture-key-pressed(event) => {
            if root.popup-open || event.modifiers.control || event.modifiers.alt || event.modifiers.shift || event.modifiers.meta {
                return reject;
            }
            if event.text == Key.Escape {
                if root.view == WorkspaceView.grid {
                    return reject;
                }
                root.view = WorkspaceView.grid;
                return accept;
            }
            return workspace.navigate(event.text, event.repeat) ? accept : reject;
        }

        VerticalLayout {
            spacing: 0px;

            header := WorkspaceHeader {
                project-title: root.project-title;
                view <=> root.view;
            }
            Rectangle { height: 1px; background: Palette.line; }
            workspace := PhotoWorkspace {
                vertical-stretch: 1;
                view: root.view;
                show-project-info: root.show-project-info;
                show-filmstrip: root.show-filmstrip;
                show-inspector: root.show-inspector;
                photo-files: root.photo-files;
                grid-photos: root.grid-photos;
                full-preview: root.full-preview;
                active-summary: root.active-summary;
                file-details: root.file-details;
                active-index <=> root.active-index;
                thumbnail-viewport-changed(first, end) => { root.thumbnail-viewport-changed(first, end); }
                preview-file-selected(index, file) => { root.preview-file-selected(index, file); }
                open-photo => { root.view = WorkspaceView.photo; }
                message-requested(message) => { root.show-message(message); }
            }
            BottomBar {
                Text {
                    text: root.status-text;
                    color: Palette.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if !root.scan-active && !root.thumbnail-reset-active && (root.generating-thumbnails || root.saving-thumbnails || root.thumbnail-progress.incomplete
                    || root.thumbnail-progress.cached < root.thumbnail-progress.total): Text {
                    text: root.generating-thumbnails ? "Generating Thumbnails"
                        : root.saving-thumbnails ? "Saving Thumbnail Previews"
                        : root.thumbnail-progress.incomplete ? "Some thumbnails could not be cached"
                        : "Cached \{root.thumbnail-progress.cached} of \{root.thumbnail-progress.total} thumbnails";
                    color: Palette.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                if root.scan-active || root.thumbnail-reset-active || root.generating-thumbnails || root.saving-thumbnails: Rectangle {
                    width: 144px;

                    ProgressIndicator {
                        width: 100%;
                        height: 5px;
                        y: (parent.height - self.height) / 2;
                        indeterminate: root.scan-active || root.thumbnail-reset-active;
                        progress: (root.saving-thumbnails ? root.thumbnail-progress.finished
                            : root.thumbnail-progress.generated) / max(1, root.thumbnail-progress.total);
                        accessible-label: root.scan-active ? "Folder scan"
                            : root.thumbnail-reset-active ? "Clearing thumbnail cache"
                            : root.saving-thumbnails ? "Saving Thumbnail Previews" : "Generating Thumbnails";
                    }
                }
            }
        }
    }

    message-dialog := MessageDialog {
        message: root.current-message;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        dismissed(accepted) => { root.message-dismissed(accepted); }
    }

    about := AboutPopup {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        version: root.app-version;
    }
}
