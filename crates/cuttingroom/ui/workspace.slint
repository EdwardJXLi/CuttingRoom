import { StandardListView } from "std-widgets.slint";
import { ActionButton } from "action-button.slint";
import { PhotoFilmstrip } from "filmstrip.slint";
import { Message, MessageSeverity } from "message-dialog.slint";
import { FullPreview, PhotoCanvas } from "photo-canvas.slint";
import { ActiveSummary, GroupDetails, GridPhoto, MetadataEntry, MetadataFile, PhotoGrid, PhotoMetadata, PreviewState } from "photo-grid.slint";
import { Palette } from "theme.slint";
import { ResizeHandle } from "resize-handle.slint";
import { Sidebar, SidebarSection } from "sidebar.slint";
import { WorkspaceView } from "workspace-header.slint";

component PhotoFileList inherits StandardListView {
    public function navigate(key: string, step: int) -> bool {
        if step != 0 {
            root.set-current-item(clamp(root.current-item + step, 0, root.model.length - 1));
            return true;
        }

        if key == Key.Home {
            root.set-current-item(0);
        } else if key == Key.End {
            root.set-current-item(root.model.length - 1);
        } else if key == Key.PageUp || key == Key.PageDown {
            let page = max(1, floor(root.visible-height * root.model.length / max(1px, root.content-height)) - 1);
            let index = root.current-item + (key == Key.PageUp ? -page : page);
            root.set-current-item(clamp(index, 0, root.model.length - 1));
        } else {
            return false;
        }
        return true;
    }
}

component MetadataRow inherits HorizontalLayout {
    in property <MetadataEntry> entry;

    min-height: 24px;
    spacing: 12px;
    Text {
        width: parent.width * 0.38;
        text: root.entry.label;
        color: Palette.muted;
        font-size: 12px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
    Text {
        min-width: 0px;
        horizontal-stretch: 1;
        text: root.entry.value;
        color: Palette.text;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component MetadataBlock inherits VerticalLayout {
    in property <MetadataFile> source;

    padding-top: 8px;

    Text {
        text: root.source.filename;
        color: Palette.text;
        font-size: 12px;
        font-weight: 600;
        wrap: word-wrap;
        accessible-role: text;
    }

    for field in root.source.fields: MetadataRow {
        entry: field;
    }
}

component PreviewFileRow inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback activated();

    private property <bool> pointer-focused;

    height: 26px;
    background: root.selected || pointer.has-hover ? Palette.hover : transparent;
    border-width: keyboard.has-focus && !root.pointer-focused ? 1px : 0px;
    border-color: Palette.focus;
    forward-focus: keyboard;
    accessible-role: list-item;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.activated(); }

    if root.selected: Rectangle {
        x: 0px;
        y: 4px;
        width: 2px;
        height: parent.height - 8px;
        background: Palette.focus;
    }

    Text {
        x: 8px;
        width: parent.width - (root.selected ? 32px : 16px);
        height: parent.height;
        text: root.text;
        color: Palette.text;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    if root.selected: Text {
        x: parent.width - 24px;
        width: 16px;
        height: parent.height;
        text: "✓";
        color: Palette.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.pointer-focused = true;
            keyboard.focus();
            root.activated();
        }
    }

    keyboard := FocusScope {
        width: 0px;
        focus-on-click: false;
        focus-lost => { root.pointer-focused = false; }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.pointer-focused = false;
                if !event.repeat { root.activated(); }
                return accept;
            }
            return reject;
        }
    }
}

export component PhotoWorkspace inherits VerticalLayout {
    in property <WorkspaceView> view;
    in property <bool> show-project-info;
    in property <bool> show-filmstrip;
    in property <bool> show-inspector;
    in property <[StandardListViewItem]> photo-files;
    in property <[GridPhoto]> grid-photos;
    in property <FullPreview> full-preview;
    in property <ActiveSummary> active-summary;
    in property <GroupDetails> group-details;
    in-out property <int> active-index: -1;
    out property <bool> metadata-summary-visible: root.has-active-photo && root.show-inspector && root.metadata-expanded;
    out property <bool> metadata-details-visible: root.metadata-summary-visible && root.details-expanded;
    callback message-requested(Message);
    callback thumbnail-viewport-changed(int, int);
    callback preview-file-selected(int, int);
    callback open-photo();

    private property <bool> browsing: root.view != WorkspaceView.photo;
    private property <bool> has-active-photo: root.active-index >= 0 && root.active-index < root.grid-photos.length;
    private property <[string]> active-files: root.has-active-photo ? root.grid-photos[root.active-index].files : [];
    private property <bool> current-preview: !root.browsing && root.full-preview.index == root.active-index;
    private property <int> requested-file: root.current-preview ? root.full-preview.requested-file : -1;
    private property <bool> photo-preview-ready: root.current-preview && root.full-preview.state == PreviewState.ready;
    private property <bool> thumbnail-ready: root.has-active-photo && root.grid-photos[root.active-index].state == PreviewState.ready
        && (root.browsing || (root.requested-file >= 0
            && root.grid-photos[root.active-index].metadata.filename == root.active-files[root.requested-file]));
    private property <PhotoMetadata> active-metadata: root.photo-preview-ready ? root.full-preview.metadata
        : root.thumbnail-ready ? root.grid-photos[root.active-index].metadata
        : root.requested-file < 0 && root.active-summary.index == root.active-index
            ? root.active-summary.metadata : { filename: "", summary: [] };
    private property <bool> metadata-expanded: true;
    private property <bool> details-expanded: false;
    private property <PreviewState> details-state: root.group-details.index == root.active-index
        ? root.group-details.state : PreviewState.pending;
    private property <bool> metadata-pending: root.requested-file >= 0 ? root.full-preview.state == PreviewState.pending
        : root.has-active-photo && !root.photo-preview-ready && !root.thumbnail-ready
            && (root.active-summary.index != root.active-index || root.active-summary.state == PreviewState.pending);
    private property <length> handle-thickness: 7px;
    private property <length> minimum-left-width: 152px;
    private property <length> maximum-left-width: 330px;
    private property <length> minimum-inspector-width: 228px;
    private property <length> maximum-inspector-width: 490px;
    private property <length> preferred-left-width: 184px;
    private property <length> preferred-inspector-width: 254px;
    private property <length> filmstrip-height: 114px;
    private property <{ first: int, end: int }> visible-thumbnails: root.browsing
        ? grid.visible-photos : filmstrip.visible-photos;

    changed visible-thumbnails => {
        root.thumbnail-viewport-changed(self.visible-thumbnails.first, self.visible-thumbnails.end);
    }

    public function navigate(key: string, repeat: bool) -> bool {
        if root.grid-photos.length == 0 {
            return false;
        }
        if root.view == WorkspaceView.grid && key == Key.Return && root.has-active-photo {
            if !repeat {
                root.open-photo();
            }
            return true;
        }
        if !root.browsing && root.active-files.length > 1 && root.requested-file >= 0 && (key == "[" || key == "]") {
            let step = key == "[" ? -1 : 1;
            root.preview-file-selected(root.active-index, mod(root.requested-file + step, root.active-files.length));
            return true;
        }
        let horizontal = key == Key.LeftArrow ? -1 : key == Key.RightArrow ? 1 : 0;
        let vertical = key == Key.UpArrow ? -1 : key == Key.DownArrow ? 1 : 0;
        if root.view == WorkspaceView.grid {
            if horizontal == 0 && vertical == 0 { return false; }
            grid.navigate(horizontal, vertical);
            return true;
        }
        let step = horizontal + vertical;
        if root.view == WorkspaceView.list {
            return files.navigate(key, step);
        }
        if step == 0 { return false; }
        root.active-index = clamp(root.active-index + step, 0, root.grid-photos.length - 1);
        return true;
    }

    spacing: 0px;

    docks := Rectangle {
        vertical-stretch: 1;

        private property <length> minimum-center-width: root.browsing ? 436px : 330px;
        private property <bool> left-open: root.browsing && root.show-project-info;
        private property <length> left-handle-width: self.left-open ? root.handle-thickness : 0px;
        private property <length> right-handle-width: root.show-inspector ? root.handle-thickness : 0px;
        private property <length> dock-space: self.width - self.minimum-center-width
            - self.left-handle-width - self.right-handle-width;
        private property <length> left-width: self.left-open ? min(root.preferred-left-width,
            self.dock-space - (root.show-inspector ? root.minimum-inspector-width : 0px)) : 0px;
        private property <length> right-width: root.show-inspector
            ? min(root.preferred-inspector-width, self.dock-space - self.left-width) : 0px;
        private property <length> center-x: self.left-width + self.left-handle-width;
        private property <length> center-width: self.width - self.center-x
            - self.right-handle-width - self.right-width;

        if docks.left-open: Sidebar {
            x: 0px;
            width: docks.left-width;
            label: "Debug sidebar";

            SidebarSection {
                title: "Debug";

                VerticalLayout {
                    spacing: 6px;

                    for demo in [
                        { label: "Test Info", severity: MessageSeverity.info,
                            heading: "Project ready", message: "Your photos are ready to browse." },
                        { label: "Test Warning", severity: MessageSeverity.warning,
                            heading: "Drive disconnected", message: "Reconnect the drive to view the photos in this project." },
                        { label: "Test Error", severity: MessageSeverity.error,
                            heading: "Could not open project", message: "Check that you have permission to read the folder and try again." },
                    ]: ActionButton {
                        text: demo.label;
                        compact: true;
                        horizontal-stretch: 1;
                        clicked => {
                            root.message-requested({ severity: demo.severity, heading: demo.heading,
                                text: demo.message, cancellable: true });
                        }
                    }
                }
            }
        }

        if docks.left-open: ResizeHandle {
            x: docks.left-width;
            width: docks.left-handle-width;
            label: "Resize left sidebar";
            size: docks.left-width;
            minimum-size: root.minimum-left-width;
            maximum-size: min(root.maximum-left-width, docks.dock-space - docks.right-width);
            resized(size) => { root.preferred-left-width = size; }
        }

        Rectangle {
            x: docks.center-x;
            width: docks.center-width;
            background: Palette.canvas;
            accessible-role: main;

            grid := PhotoGrid {
                visible: root.view == WorkspaceView.grid;
                photos: root.grid-photos;
                active-index <=> root.active-index;
                open-photo => { root.open-photo(); }
            }

            files := PhotoFileList {
                visible: root.view == WorkspaceView.list && root.photo-files.length > 0;
                width: 100%;
                height: 100%;
                accessible-label: "Photo files";
                model: root.photo-files;
                current-item <=> root.active-index;
                changed visible => {
                    if self.visible && root.has-active-photo {
                        self.ensure-row-visible(root.active-index, ScrollBehavior.instant);
                    }
                }
            }

            if root.view == WorkspaceView.photo: PhotoCanvas {
                photos: root.grid-photos;
                preview: root.full-preview;
                active-index: root.active-index;
            }
        }

        if root.show-inspector: ResizeHandle {
            x: docks.center-x + docks.center-width;
            width: docks.right-handle-width;
            label: "Resize right sidebar";
            size: docks.right-width;
            minimum-size: root.minimum-inspector-width;
            maximum-size: min(root.maximum-inspector-width, docks.dock-space - docks.left-width);
            reverse: true;
            resized(size) => { root.preferred-inspector-width = size; }
        }

        if root.show-inspector: Sidebar {
            x: docks.width - self.width;
            width: docks.right-width;
            label: "Photo sidebar";

            SidebarSection {
                title: "Photo";
                detail: !root.browsing && root.active-files.length > 1 ? "[ or ]" : "";

                if !root.has-active-photo: Text {
                    height: 24px;
                    text: "No photo selected";
                    color: Palette.muted;
                    vertical-alignment: center;
                }

                for file in root.browsing || root.active-files.length <= 1 ? root.active-files : []: Text {
                    height: 24px;
                    text: file;
                    color: Palette.text;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: text;
                }

                if !root.browsing && root.active-files.length > 1: VerticalLayout {
                    accessible-role: list;
                    accessible-label: "Preview source";

                    for file[index] in root.active-files: PreviewFileRow {
                        text: file;
                        selected: root.requested-file == index;
                        accessible-description: !self.selected ? "" : root.photo-preview-ready ? "Displayed preview"
                            : root.full-preview.state == PreviewState.pending ? "Rendering preview" : "Preview unavailable";
                        activated => { root.preview-file-selected(root.active-index, index); }
                    }
                }
            }

            if root.has-active-photo: SidebarSection {
                title: "Metadata";
                expanded <=> root.metadata-expanded;

                if root.active-metadata.summary.length == 0: Text {
                    height: 27px;
                    text: root.metadata-pending ? "Loading metadata…" : "Metadata unavailable";
                    color: Palette.muted;
                    vertical-alignment: center;
                }

                for field in root.active-metadata.summary: MetadataRow {
                    entry: field;
                }

                SidebarSection {
                    title: "Show all";
                    compact: true;
                    expanded <=> root.details-expanded;

                    if root.metadata-details-visible && root.details-state != PreviewState.ready: Text {
                        height: 27px;
                        text: root.details-state == PreviewState.pending ? "Loading file metadata…" : "File metadata unavailable";
                        color: Palette.muted;
                        vertical-alignment: center;
                    }
                    for file in root.metadata-details-visible && root.details-state == PreviewState.ready ? root.group-details.files : []: MetadataBlock {
                        source: file;
                    }
                    if root.metadata-details-visible && root.details-state == PreviewState.ready && root.group-details.sidecars.length > 0: Text {
                        height: 26px;
                        text: "XMP sidecars";
                        color: Palette.text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: bottom;
                        accessible-role: text;
                    }
                    for sidecar in root.metadata-details-visible && root.details-state == PreviewState.ready ? root.group-details.sidecars : []: MetadataBlock {
                        source: sidecar;
                    }
                }
            }
        }
    }

    if filmstrip.visible && filmstrip.expanded: ResizeHandle {
        height: root.handle-thickness;
        label: "Resize Filmstrip";
        size: root.filmstrip-height;
        minimum-size: 104px;
        maximum-size: 240px;
        resize-axis: Orientation.vertical;
        reverse: true;
        resized(size) => { root.filmstrip-height = size; }
    }

    filmstrip := PhotoFilmstrip {
        visible: !root.browsing && root.show-filmstrip;
        photos: root.grid-photos;
        body-height: root.filmstrip-height;
        active-index <=> root.active-index;
    }
}
