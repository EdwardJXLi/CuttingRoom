import { StandardListView } from "std-widgets.slint";
import { ActionButton } from "action-button.slint";
import { Message, MessageSeverity } from "message-dialog.slint";
import { FullPreview, PhotoCanvas } from "photo-canvas.slint";
import { GridPhoto, MetadataEntry, PhotoGrid, PhotoMetadata, PreviewState } from "photo-grid.slint";
import { Palette } from "theme.slint";
import { ResizeHandle } from "resize-handle.slint";
import { Sidebar, SidebarSection } from "sidebar.slint";
import { WorkspaceView } from "workspace-header.slint";

component WorkspacePane inherits Rectangle {
    in property <string> heading;

    @children

    background: Palette.panel;
    accessible-role: complementary;
    accessible-label: root.heading;

    Text {
        x: 16px;
        y: 0px;
        width: parent.width - 32px;
        height: 38px;
        text: root.heading;
        color: Palette.text;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

component MetadataRow inherits HorizontalLayout {
    in property <MetadataEntry> entry;

    min-height: 24px;
    spacing: 12px;
    Text {
        width: parent.width * 0.38;
        text: root.entry.label;
        color: Palette.muted;
        font-size: 12px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
    Text {
        min-width: 0px;
        horizontal-stretch: 1;
        text: root.entry.value;
        color: Palette.text;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

export component PhotoWorkspace inherits VerticalLayout {
    in property <WorkspaceView> view;
    in property <bool> show-project-info;
    in property <bool> show-filmstrip;
    in property <bool> show-inspector;
    in property <[StandardListViewItem]> photo-files;
    in property <[GridPhoto]> grid-photos;
    in property <FullPreview> full-preview;
    in-out property <int> active-index: -1;
    callback message-requested(Message);
    callback grid-viewport-changed(int, int);
    callback open-photo();

    private property <bool> browsing: root.view != WorkspaceView.photo;
    private property <bool> has-active-photo: root.active-index >= 0 && root.active-index < root.grid-photos.length;
    private property <string> active-photo-name: root.has-active-photo ? root.grid-photos[root.active-index].name : "";
    private property <bool> preview-complete: !root.browsing && root.full-preview.index == root.active-index
        && root.full-preview.state != PreviewState.pending;
    private property <PhotoMetadata> active-metadata: root.preview-complete ? root.full-preview.metadata
        : root.has-active-photo ? root.grid-photos[root.active-index].metadata : { summary: [], details: [] };
    private property <bool> metadata-pending: root.has-active-photo && !root.preview-complete
        && (!root.browsing || root.grid-photos[root.active-index].state == PreviewState.pending);
    private property <length> handle-thickness: 7px;
    private property <length> minimum-left-width: 152px;
    private property <length> maximum-left-width: 330px;
    private property <length> minimum-inspector-width: 228px;
    private property <length> maximum-inspector-width: 490px;
    private property <length> preferred-left-width: 184px;
    private property <length> preferred-inspector-width: 254px;
    private property <length> filmstrip-height: 114px;

    spacing: 0px;

    docks := Rectangle {
        vertical-stretch: 1;

        private property <length> minimum-center-width: root.browsing ? 436px : 330px;
        private property <bool> left-open: root.browsing && root.show-project-info;
        private property <length> left-handle-width: self.left-open ? root.handle-thickness : 0px;
        private property <length> right-handle-width: root.show-inspector ? root.handle-thickness : 0px;
        private property <length> dock-space: self.width - self.minimum-center-width
            - self.left-handle-width - self.right-handle-width;
        private property <length> left-width: self.left-open ? min(root.preferred-left-width,
            self.dock-space - (root.show-inspector ? root.minimum-inspector-width : 0px)) : 0px;
        private property <length> right-width: root.show-inspector
            ? min(root.preferred-inspector-width, self.dock-space - self.left-width) : 0px;
        private property <length> center-x: self.left-width + self.left-handle-width;
        private property <length> center-width: self.width - self.center-x
            - self.right-handle-width - self.right-width;

        if docks.left-open: Sidebar {
            x: 0px;
            width: docks.left-width;
            label: "Debug sidebar";

            SidebarSection {
                title: "Debug";

                VerticalLayout {
                    spacing: 6px;

                    for demo in [
                        { label: "Test Info", severity: MessageSeverity.info,
                            heading: "Project ready", message: "Your photos are ready to browse." },
                        { label: "Test Warning", severity: MessageSeverity.warning,
                            heading: "Drive disconnected", message: "Reconnect the drive to view the photos in this project." },
                        { label: "Test Error", severity: MessageSeverity.error,
                            heading: "Could not open project", message: "Check that you have permission to read the folder and try again." },
                    ]: ActionButton {
                        text: demo.label;
                        compact: true;
                        horizontal-stretch: 1;
                        clicked => {
                            root.message-requested({ severity: demo.severity, heading: demo.heading,
                                text: demo.message, cancellable: true });
                        }
                    }
                }
            }
        }

        if docks.left-open: ResizeHandle {
            x: docks.left-width;
            width: docks.left-handle-width;
            label: "Resize left sidebar";
            size: docks.left-width;
            minimum-size: root.minimum-left-width;
            maximum-size: min(root.maximum-left-width, docks.dock-space - docks.right-width);
            resized(size) => { root.preferred-left-width = size; }
        }

        Rectangle {
            x: docks.center-x;
            width: docks.center-width;
            background: Palette.canvas;
            accessible-role: main;

            if root.view == WorkspaceView.grid: PhotoGrid {
                photos: root.grid-photos;
                active-index <=> root.active-index;
                viewport-changed(first, end) => { root.grid-viewport-changed(first, end); }
                open-photo => { root.open-photo(); }
            }

            if root.view == WorkspaceView.list && root.photo-files.length > 0: StandardListView {
                width: 100%;
                height: 100%;
                accessible-label: "Photo files";
                model: root.photo-files;
                current-item <=> root.active-index;
            }

            if root.view == WorkspaceView.photo: PhotoCanvas {
                photos: root.grid-photos;
                preview: root.full-preview;
                active-index <=> root.active-index;
            }
        }

        if root.show-inspector: ResizeHandle {
            x: docks.center-x + docks.center-width;
            width: docks.right-handle-width;
            label: "Resize right sidebar";
            size: docks.right-width;
            minimum-size: root.minimum-inspector-width;
            maximum-size: min(root.maximum-inspector-width, docks.dock-space - docks.left-width);
            reverse: true;
            resized(size) => { root.preferred-inspector-width = size; }
        }

        if root.show-inspector: Sidebar {
            x: docks.width - self.width;
            width: docks.right-width;
            label: "Photo sidebar";

            SidebarSection {
                title: "Photo";

                Text {
                    height: 24px;
                    text: root.active-photo-name == "" ? "No photo selected" : root.active-photo-name;
                    color: root.active-photo-name == "" ? Palette.muted : Palette.text;
                    font-weight: root.active-photo-name == "" ? 400 : 600;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: text;
                }
            }

            if root.has-active-photo: metadata-section := SidebarSection {
                title: "Metadata";

                if root.active-metadata.summary.length == 0: Text {
                    height: 27px;
                    text: root.metadata-pending ? "Loading metadata…" : "Metadata unavailable";
                    color: Palette.muted;
                    vertical-alignment: center;
                }

                for field in root.active-metadata.summary: MetadataRow {
                    entry: field;
                }

                if root.active-metadata.details.length > 0: all := SidebarSection {
                    title: "Show all";
                    compact: true;
                    expanded: false;

                    for detail in metadata-section.expanded && all.expanded ? root.active-metadata.details : []: MetadataRow {
                        entry: detail;
                    }
                }
            }
        }
    }

    if !root.browsing && root.show-filmstrip: ResizeHandle {
        height: root.handle-thickness;
        label: "Resize Filmstrip";
        size: root.filmstrip-height;
        minimum-size: 104px;
        maximum-size: 240px;
        resize-axis: Orientation.vertical;
        reverse: true;
        resized(size) => { root.filmstrip-height = size; }
    }

    if !root.browsing && root.show-filmstrip: WorkspacePane {
        height: 38px + root.filmstrip-height;
        heading: "Filmstrip";
    }
}
