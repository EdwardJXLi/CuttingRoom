import { AboutSlint, StandardButton } from "std-widgets.slint";
import { Palette } from "theme.slint";

export component AboutPopup inherits PopupWindow {
    in property <string> version;

    width: 400px;
    height: content.preferred-height + 20px;
    close-policy: close-on-click-outside;
    init => { keyboard.focus(); }

    keyboard := FocusScope {
        forward-focus: close-button;

        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            background: Palette.panel;
            border-width: 1px;
            border-color: #777777;
            border-radius: 8px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 4px;
            drop-shadow-blur: 12px;
            accessible-role: groupbox;
            accessible-label: "About CuttingRoom";

            content := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "CuttingRoom";
                        font-size: 23px;
                        font-weight: 600;
                        color: Palette.text;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Version " + root.version;
                        color: Palette.muted;
                        horizontal-alignment: center;
                    }
                }

                Rectangle { height: 1px; background: Palette.line; }
                AboutSlint {
                    preferred-height: self.min-height;
                    vertical-stretch: 0;
                }

                HorizontalLayout {
                    alignment: center;
                    close-button := StandardButton {
                        kind: close;
                        clicked => { root.close(); }
                    }
                }
            }
        }
    }
}
