import { GridPhoto, PhotoMetadata, PreviewState } from "photo-grid.slint";
import { Palette } from "theme.slint";

export struct FullPreview {
    index: int,
    image: image,
    state: PreviewState,
    metadata: PhotoMetadata,
}

export component PhotoCanvas inherits Rectangle {
    in property <[GridPhoto]> photos;
    in property <FullPreview> preview;
    in property <int> active-index;

    private property <bool> has-active-photo: root.active-index >= 0 && root.active-index < root.photos.length;
    private property <GridPhoto> photo: root.photos[root.active-index];
    private property <PreviewState> state: root.preview.index == root.active-index
        ? root.preview.state : PreviewState.pending;
    private property <bool> show-thumbnail: root.state == PreviewState.pending && root.photo.state == PreviewState.ready;

    if root.has-active-photo && (root.state == PreviewState.ready || root.show-thumbnail): Image {
        x: 20px;
        y: 16px;
        width: parent.width - 40px;
        height: parent.height - 32px;
        source: root.show-thumbnail ? root.photo.preview : root.preview.image;
        image-fit: contain;
        accessible-label: root.photo.relative-path;
    }

    if !root.has-active-photo || (root.state != PreviewState.ready && !root.show-thumbnail): Text {
        width: 100%;
        height: 100%;
        text: !root.has-active-photo ? "No photo selected"
            : root.state == PreviewState.pending ? "Loading preview…"
            : root.state == PreviewState.decoder-unavailable ? "Preview decoder unavailable"
            : "Preview unavailable";
        color: Palette.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
