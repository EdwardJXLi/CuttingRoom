export global Palette {
    out property <color> canvas: #1a1a1a;
    out property <color> panel: #242424;
    out property <color> hover: #303030;
    out property <color> line: #3a3a3a;
    out property <color> text: #f0f0f0;
    out property <color> muted: #b5b5b5;
    out property <color> focus: #bfbfbf;
}
